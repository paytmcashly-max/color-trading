NODE_ENV=production
PORT=4000
CLIENT_URL=https://app.example.com
CLIENT_ORIGIN=https://app.example.com
ALLOWED_ORIGINS=https://app.example.com
SOCKET_CORS_ORIGIN=https://app.example.com
SOCKET_ALLOWED_ORIGINS=https://app.example.com
API_VERSION=v1
RELEASE_VERSION=replace-with-release-sha
DATABASE_URL=postgresql://user:password@host:5432/color_trading?sslmode=require
REDIS_URL=rediss://user:password@host:6379
JWT_ACCESS_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-at-least-32-characters
JWT_ACCESS_TOKEN_TTL=15m
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_REFRESH_TOKEN_TTL=7d
JWT_REFRESH_TOKEN_TTL_DAYS=7
JWT_ISSUER=color-trading-api
JWT_AUDIENCE=color-trading-client
GAME_ROUND_DURATION_SECONDS=60
GAME_BETTING_DURATION_SECONDS=45
GAME_SCHEDULER_TICK_MS=1000
GAME_ROUND_LOCK_TTL_MS=5000
GAME_ENGINE_ENABLED=true
