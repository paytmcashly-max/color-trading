generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [citext, pgcrypto]
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum UserRole {
  USER
  ADMIN
}

enum WalletStatus {
  ACTIVE
  FROZEN
  CLOSED
}

enum CoinLedgerType {
  BET_DEBIT
  BET_WIN_CREDIT
  PURCHASE_CREDIT
  BONUS_CREDIT
  ADMIN_ADJUSTMENT
}

enum CoinLedgerDirection {
  DEBIT
  CREDIT
}

enum CoinLedgerStatus {
  PENDING
  SUCCESS
  FAILED
}

enum LedgerReferenceType {
  BET
  ROUND
  COIN_PACKAGE
  ADMIN_ACTION
  EXTERNAL_PURCHASE
}

enum RoundStatus {
  INIT
  OPEN
  LOCKED
  RESOLVING
  COMPLETED
  CANCELLED
}

enum PredictionColor {
  RED
  GREEN
  VIOLET
}

enum BetStatus {
  PENDING
  WON
  LOST
  CANCELLED
}

enum FraudSeverity {
  LOW
  MEDIUM
  HIGH
}

enum LogLevel {
  DEBUG
  INFO
  WARN
  ERROR
}

enum PaymentIntentStatus {
  CREATED
  PAYMENT_STARTED
  PAID_VERIFIED
  CREDITED
  FAILED
  EXPIRED
}

enum PaymentIntentPurpose {
  PREMIUM_CREDITS
  REAL_MONEY_GAME_DEPOSIT
}

enum RealMoneyWalletStatus {
  ACTIVE
  FROZEN
  CLOSED
}

enum RealMoneyLedgerType {
  DEPOSIT_APPROVED
  BET_LOCKED
  BET_WON_PAYOUT
  BET_LOST_SETTLED
  BET_REFUND
  WITHDRAWAL_LOCKED
  WITHDRAWAL_REJECTED_RELEASE
  WITHDRAWAL_PAID
  ADMIN_ADJUSTMENT
}

enum RealMoneyBetStatus {
  PENDING
  WON
  LOST
  CANCELLED
  REFUNDED
}

enum RealMoneySettlementStatus {
  PENDING
  SUCCESS
  FAILED
}

enum KycStatus {
  NOT_SUBMITTED
  PENDING_REVIEW
  VERIFIED
  REJECTED
  SUSPENDED
}

enum RealMoneyDepositStatus {
  INTENT_CREATED
  PAID_VERIFIED
  CREDITED
  FAILED
}

enum RealMoneyWithdrawalStatus {
  REQUESTED
  APPROVED
  REJECTED
  PAID
  CANCELLED
}

model User {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String     @unique @db.Citext
  passwordHash    String     @map("password_hash")
  displayName     String?    @map("display_name") @db.VarChar(80)
  status          UserStatus @default(ACTIVE)
  role            UserRole   @default(USER)
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(6)
  lastLoginAt     DateTime?  @map("last_login_at") @db.Timestamptz(6)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  wallet              Wallet?
  bets                Bet[]
  ledgerEntries       CoinLedger[]
  sessions            AuthSession[]
  auditLogs           AuditLog[]                 @relation("AdminAuditLogs")
  fraudLogs           FraudLog[]
  riskProfile         UserRiskProfile?
  paymentIntents      PaymentIntent[]
  premiumCreditWallet PremiumCreditWallet?
  premiumCreditLedger PremiumCreditLedgerEntry[]
  realMoneyWallet     RealMoneyGameWallet?
  realMoneyLedger     RealMoneyGameLedgerEntry[]
  realMoneyBets       RealMoneyBet[]
  realMoneyDeposits   RealMoneyDeposit[]
  realMoneyWithdrawals RealMoneyWithdrawal[]
  kycProfile          UserKycProfile?
  responsibleGamingLimit ResponsibleGamingLimit?

  @@index([role])
  @@index([status])
  @@index([createdAt])
  @@map("users")
}

model FraudLog {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String?       @map("user_id") @db.Uuid
  eventType String        @map("event_type") @db.VarChar(80)
  severity  FraudSeverity
  metadata  Json?
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([eventType, createdAt])
  @@index([severity, createdAt])
  @@map("fraud_logs")
}

model LogEntry {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  level     LogLevel
  message   String   @db.VarChar(240)
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([level, createdAt])
  @@index([message, createdAt])
  @@map("logs")
}

model SystemMetric {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  metricName String   @map("metric_name") @db.VarChar(120)
  value      Decimal  @db.Decimal(18, 4)
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([metricName, createdAt])
  @@map("system_metrics")
}

model UserRiskProfile {
  userId       String   @id @map("user_id") @db.Uuid
  riskScore    Int      @default(0) @map("risk_score")
  isBlocked    Boolean  @default(false) @map("is_blocked")
  botSuspected Boolean  @default(false) @map("bot_suspected")
  realMoneyBetBlocked Boolean @default(false) @map("real_money_bet_blocked")
  realMoneyDepositBlocked Boolean @default(false) @map("real_money_deposit_blocked")
  realMoneyWithdrawalBlocked Boolean @default(false) @map("real_money_withdrawal_blocked")
  realMoneyBlockReason String? @map("real_money_block_reason") @db.VarChar(240)
  lastUpdated  DateTime @default(now()) @map("last_updated") @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([riskScore])
  @@index([isBlocked])
  @@index([botSuspected])
  @@map("user_risk_profiles")
}

model AuditLog {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adminUserId    String?  @map("admin_user_id") @db.Uuid
  actorId        String?  @map("actor_id") @db.VarChar(120)
  actorType      String   @default("ADMIN") @map("actor_type") @db.VarChar(40)
  action         String?  @db.VarChar(120)
  actionType     String   @map("action_type") @db.VarChar(80)
  idempotencyKey String?  @unique @map("idempotency_key") @db.VarChar(160)
  targetType     String?  @map("target_type") @db.VarChar(80)
  targetId       String?  @map("target_id") @db.VarChar(120)
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  adminUser User? @relation("AdminAuditLogs", fields: [adminUserId], references: [id], onDelete: Restrict)

  @@index([adminUserId, createdAt])
  @@index([actionType, createdAt])
  @@index([targetType, targetId])
  @@map("audit_logs")
}

model GameControl {
  id        String   @id @default("global") @db.VarChar(32)
  paused    Boolean  @default(false)
  reason    String?  @db.VarChar(500)
  updatedBy String?  @map("updated_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("game_controls")
}

model AuthSession {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash") @db.VarChar(128)
  userAgent        String?   @map("user_agent") @db.VarChar(512)
  ipAddress        String?   @map("ip_address") @db.Inet
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("auth_sessions")
}

model Wallet {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String       @unique @map("user_id") @db.Uuid
  depositBalance BigInt       @default(1000) @map("deposit_balance")
  winningBalance BigInt       @default(0) @map("winning_balance")
  ledgerVersion  BigInt       @default(0) @map("ledger_version")
  status         WalletStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  user          User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  ledgerEntries CoinLedger[]

  @@index([status])
  @@map("wallets")
}

model CoinLedger {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String               @map("user_id") @db.Uuid
  walletId           String               @map("wallet_id") @db.Uuid
  type               CoinLedgerType
  direction          CoinLedgerDirection
  amountCoins        BigInt               @map("amount_coins")
  balanceBeforeCoins BigInt?              @map("balance_before_coins")
  balanceAfterCoins  BigInt?              @map("balance_after_coins")
  idempotencyKey     String               @unique @map("idempotency_key") @db.VarChar(160)
  referenceType      LedgerReferenceType? @map("reference_type")
  referenceId        String?              @map("reference_id") @db.Uuid
  status             CoinLedgerStatus     @default(PENDING)
  metadata           Json?
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([walletId, createdAt])
  @@index([referenceType, referenceId])
  @@index([status, createdAt])
  @@index([type, createdAt])
  @@map("coin_ledger")
}

model WalletTransaction {
  id            String   @id @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  type          String   @db.VarChar(80)
  amount        BigInt
  balanceBefore BigInt?  @map("balance_before")
  balanceAfter  BigInt?  @map("balance_after")
  createdAt     DateTime @map("created_at") @db.Timestamptz(6)

  @@map("wallet_transactions")
}

model GameRound {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @map("round_id") @db.Uuid
  roundNumber BigInt           @unique @map("round_number")
  startTime   DateTime         @map("start_time") @db.Timestamptz(6)
  lockTime    DateTime         @map("lock_time") @db.Timestamptz(6)
  endTime     DateTime         @map("end_time") @db.Timestamptz(6)
  status      RoundStatus      @default(INIT)
  result      PredictionColor?
  seedHash    String           @map("seed_hash") @db.VarChar(128)
  seedReveal  String?          @map("seed_reveal") @db.VarChar(128)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  bets       Bet[]
  settlement RoundSettlement?
  secret     GameRoundSecret?
  realMoneyBets RealMoneyBet[]
  realMoneySettlement RealMoneyRoundSettlement?

  @@index([status, startTime])
  @@index([startTime])
  @@index([lockTime])
  @@index([endTime])
  @@map("game_rounds")
}

model GameRoundSecret {
  roundId             String    @id @map("round_id") @db.Uuid
  seedRevealEncrypted String    @map("seed_reveal_encrypted") @db.Text
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  revealedAt          DateTime? @map("revealed_at") @db.Timestamptz(6)

  round GameRound @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@index([revealedAt])
  @@map("game_round_secrets")
}

model RoundSettlement {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roundId          String          @unique @map("round_id") @db.Uuid
  result           PredictionColor
  status           String          @default("PENDING") @db.VarChar(32)
  totalBets        Int             @default(0) @map("total_bets")
  winningBets      Int             @default(0) @map("winning_bets")
  losingBets       Int             @default(0) @map("losing_bets")
  totalPayoutCoins BigInt          @default(0) @map("total_payout_coins")
  metadata         Json?
  startedAt        DateTime        @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt      DateTime?       @map("completed_at") @db.Timestamptz(6)
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  round GameRound @relation(fields: [roundId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@map("round_settlements")
}

model Bet {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String          @map("user_id") @db.Uuid
  roundId        String          @map("round_id") @db.Uuid
  choice         PredictionColor
  coinsStaked    BigInt          @map("coins_staked")
  idempotencyKey String          @unique @map("idempotency_key") @db.VarChar(160)
  status         BetStatus       @default(PENDING)
  payoutAmount   BigInt          @default(0) @map("payout_amount")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  user  User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  round GameRound @relation(fields: [roundId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([userId, roundId])
  @@index([roundId])
  @@index([roundId, status])
  @@index([roundId, status, choice, userId])
  @@index([status, createdAt])
  @@map("bets")
}

model CoinPackage {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @db.VarChar(80)
  coinsAmount Int      @map("coins_amount")
  price       Decimal? @db.Decimal(12, 2)
  active      Boolean  @default(true)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([active, sortOrder])
  @@map("coin_packages")
}

model PaymentIntent {
  id                    String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                String              @map("user_id") @db.Uuid
  amountPaise           BigInt              @map("amount_paise")
  purpose               PaymentIntentPurpose @default(PREMIUM_CREDITS)
  status                PaymentIntentStatus @default(CREATED)
  paymentServiceOrderId String?             @map("payment_service_order_id") @db.VarChar(80)
  provider              String?             @db.VarChar(40)
  providerTxnId         String?             @unique @map("provider_txn_id") @db.VarChar(120)
  idempotencyKey        String              @unique @map("idempotency_key") @db.VarChar(160)
  creditedAt            DateTime?           @map("credited_at") @db.Timestamptz(6)
  expiresAt             DateTime            @map("expires_at") @db.Timestamptz(6)
  createdAt             DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  user                 User                       @relation(fields: [userId], references: [id], onDelete: Restrict)
  processedEvents      ProcessedPaymentEvent[]
  premiumLedgerEntries PremiumCreditLedgerEntry[]
  realMoneyDeposit     RealMoneyDeposit?

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("payment_intents")
}

model RealMoneyGameWallet {
  id             String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String                @unique @map("user_id") @db.Uuid
  availablePaise BigInt                @default(0) @map("available_paise")
  lockedPaise    BigInt                @default(0) @map("locked_paise")
  ledgerVersion  BigInt                @default(0) @map("ledger_version")
  status         RealMoneyWalletStatus @default(ACTIVE)
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  user          User                       @relation(fields: [userId], references: [id], onDelete: Restrict)
  ledgerEntries RealMoneyGameLedgerEntry[]

  @@index([status])
  @@map("real_money_game_wallets")
}

model RealMoneyGameLedgerEntry {
  id                   String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  walletId             String              @map("wallet_id") @db.Uuid
  userId               String              @map("user_id") @db.Uuid
  type                 RealMoneyLedgerType
  amountPaise          BigInt              @map("amount_paise")
  availableBeforePaise BigInt              @map("available_before_paise")
  availableAfterPaise  BigInt              @map("available_after_paise")
  lockedBeforePaise    BigInt              @map("locked_before_paise")
  lockedAfterPaise     BigInt              @map("locked_after_paise")
  idempotencyKey       String              @unique @map("idempotency_key") @db.VarChar(160)
  referenceType        String              @map("reference_type") @db.VarChar(60)
  referenceId          String              @map("reference_id") @db.VarChar(120)
  metadata             Json?
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  wallet RealMoneyGameWallet @relation(fields: [walletId], references: [id], onDelete: Restrict)
  user   User                @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([referenceType, referenceId])
  @@map("real_money_game_ledger")
}

model RealMoneyBet {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String             @map("user_id") @db.Uuid
  roundId        String             @map("round_id") @db.Uuid
  choice         PredictionColor
  stakePaise     BigInt             @map("stake_paise")
  payoutPaise    BigInt             @default(0) @map("payout_paise")
  status         RealMoneyBetStatus @default(PENDING)
  idempotencyKey String             @unique @map("idempotency_key") @db.VarChar(160)
  settledAt      DateTime?          @map("settled_at") @db.Timestamptz(6)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  user  User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  round GameRound @relation(fields: [roundId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([roundId, status])
  @@index([roundId, choice])
  @@map("real_money_bets")
}

model RealMoneyRoundSettlement {
  id               String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roundId          String                    @unique @map("round_id") @db.Uuid
  result           PredictionColor
  status           RealMoneySettlementStatus @default(PENDING)
  totalBets        Int                       @default(0) @map("total_bets")
  totalPayoutPaise BigInt                    @default(0) @map("total_payout_paise")
  failureReason    String?                   @map("failure_reason") @db.VarChar(500)
  startedAt        DateTime                  @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt      DateTime?                 @map("completed_at") @db.Timestamptz(6)
  createdAt        DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)

  round GameRound @relation(fields: [roundId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@map("real_money_round_settlements")
}

model UserKycProfile {
  userId       String    @id @map("user_id") @db.Uuid
  status       KycStatus @default(NOT_SUBMITTED)
  jurisdiction String?   @db.VarChar(80)
  reviewNote   String?   @map("review_note") @db.VarChar(500)
  reviewedBy   String?   @map("reviewed_by") @db.Uuid
  reviewedAt   DateTime? @map("reviewed_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("user_kyc_profiles")
}

model ResponsibleGamingLimit {
  userId               String    @id @map("user_id") @db.Uuid
  dailyDepositPaise    BigInt?   @map("daily_deposit_paise")
  dailyWithdrawalPaise BigInt?   @map("daily_withdrawal_paise")
  dailyLossPaise       BigInt?   @map("daily_loss_paise")
  perBetPaise          BigInt?   @map("per_bet_paise")
  selfExcludedUntil    DateTime? @map("self_excluded_until") @db.Timestamptz(6)
  coolingOffUntil      DateTime? @map("cooling_off_until") @db.Timestamptz(6)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("responsible_gaming_limits")
}

model RealMoneyDeposit {
  id              String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String                 @map("user_id") @db.Uuid
  paymentIntentId String                 @unique @map("payment_intent_id") @db.Uuid
  amountPaise     BigInt                 @map("amount_paise")
  status          RealMoneyDepositStatus @default(INTENT_CREATED)
  providerTxnId   String?                @unique @map("provider_txn_id") @db.VarChar(120)
  creditedAt      DateTime?              @map("credited_at") @db.Timestamptz(6)
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  user   User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  intent PaymentIntent @relation(fields: [paymentIntentId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("real_money_deposits")
}

model RealMoneyWithdrawal {
  id             String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String                    @map("user_id") @db.Uuid
  amountPaise    BigInt                    @map("amount_paise")
  status         RealMoneyWithdrawalStatus @default(REQUESTED)
  idempotencyKey String                    @unique @map("idempotency_key") @db.VarChar(160)
  reviewNote     String?                   @map("review_note") @db.VarChar(500)
  reviewedBy     String?                   @map("reviewed_by") @db.Uuid
  reviewedAt     DateTime?                 @map("reviewed_at") @db.Timestamptz(6)
  paidAt         DateTime?                 @map("paid_at") @db.Timestamptz(6)
  createdAt      DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("real_money_withdrawals")
}

model ProcessedPaymentEvent {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId     String   @unique @map("event_id") @db.Uuid
  intentId    String   @map("intent_id") @db.Uuid
  provider    String   @db.VarChar(40)
  status      String   @db.VarChar(40)
  payloadHash String   @map("payload_hash") @db.VarChar(64)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  intent PaymentIntent @relation(fields: [intentId], references: [id], onDelete: Restrict)

  @@index([intentId])
  @@map("processed_payment_events")
}

model PremiumCreditWallet {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String   @unique @map("user_id") @db.Uuid
  balanceCredits BigInt   @default(0) @map("balance_credits")
  ledgerVersion  BigInt   @default(0) @map("ledger_version")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user          User                       @relation(fields: [userId], references: [id], onDelete: Restrict)
  ledgerEntries PremiumCreditLedgerEntry[]

  @@map("premium_credit_wallets")
}

model PremiumCreditLedgerEntry {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  walletId        String   @map("wallet_id") @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  credits         BigInt
  balanceBefore   BigInt   @map("balance_before")
  balanceAfter    BigInt   @map("balance_after")
  paymentIntentId String   @map("payment_intent_id") @db.Uuid
  idempotencyKey  String   @unique @map("idempotency_key") @db.VarChar(160)
  metadata        Json?
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  wallet PremiumCreditWallet @relation(fields: [walletId], references: [id], onDelete: Restrict)
  user   User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  intent PaymentIntent       @relation(fields: [paymentIntentId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([paymentIntentId])
  @@map("premium_credit_ledger")
}
