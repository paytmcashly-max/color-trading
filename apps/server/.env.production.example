NODE_ENV=production
# Required production envs: DATABASE_URL, REDIS_URL, JWT_ACCESS_SECRET,
# JWT_REFRESH_SECRET, COOKIE_SECRET, ROUND_SEED_ENCRYPTION_KEY, CLIENT_ORIGIN,
# ALLOWED_ORIGINS, SOCKET_ALLOWED_ORIGINS, PAYMENT_APP_URL,
# PAYMENT_INTENT_SIGNING_SECRET, PAYMENT_SERVICE_SECRET. Secrets must be unique strong
# random values and must not keep these placeholders.
PORT=4000
CLIENT_ORIGIN=https://app.example.com
ALLOWED_ORIGINS=https://app.example.com
SOCKET_ALLOWED_ORIGINS=https://app.example.com
API_PREFIX=/api/v1
API_VERSION=v1
RELEASE_VERSION=replace-with-release-sha
DATABASE_URL=postgresql://user:password@host:5432/color_trading?sslmode=require
REDIS_URL=rediss://user:password@host:6379
JWT_ACCESS_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-at-least-32-characters
COOKIE_SECRET=replace-with-a-different-random-cookie-secret-at-least-32-characters
ROUND_SEED_ENCRYPTION_KEY=replace-with-a-dedicated-random-round-seed-key-at-least-32-characters
JWT_ACCESS_TOKEN_TTL=15m
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_REFRESH_TOKEN_TTL=7d
JWT_REFRESH_TOKEN_TTL_DAYS=7
JWT_ISSUER=color-trading-api
JWT_AUDIENCE=color-trading-client
GAME_ROUND_DURATION_SECONDS=60
GAME_BETTING_DURATION_SECONDS=45
GAME_SCHEDULER_TICK_MS=1000
GAME_ROUND_LOCK_TTL_MS=5000
GAME_MAX_BET_PER_USER_PER_ROUND=1000
GAME_MAX_EXPOSURE_PER_COLOR=100000
GAME_ENGINE_ENABLED=true
PAYMENT_APP_URL=https://payments.example.com
PAYMENT_INTENT_SIGNING_SECRET=replace-with-production-payment-intent-secret-at-least-32-characters
PAYMENT_SERVICE_SECRET=replace-with-different-production-payment-event-secret-at-least-32-characters
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_CONFIRM=
ADMIN_BOOTSTRAP_TOKEN=replace-with-private-one-time-bootstrap-token
ADMIN_DISPLAY_NAME=Admin
ADMIN_BOOTSTRAP_ROTATE_PASSWORD=false
ADMIN_BOOTSTRAP_INITIAL_COINS=1000
ADMIN_BOOTSTRAP_DISABLE_REASON=FIRST_ADMIN_CREATED
