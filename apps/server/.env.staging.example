NODE_ENV=staging
PORT=4000
CLIENT_URL=https://staging.example.com
CLIENT_ORIGIN=https://staging.example.com
ALLOWED_ORIGINS=https://staging.example.com
SOCKET_CORS_ORIGIN=https://staging.example.com
SOCKET_ALLOWED_ORIGINS=https://staging.example.com
API_VERSION=v1
RELEASE_VERSION=0.1.0-staging
DATABASE_URL=postgresql://user:password@host:5432/color_trading_staging
REDIS_URL=redis://host:6379
JWT_SECRET=replace-with-at-least-32-characters-staging-secret
JWT_ACCESS_SECRET=replace-with-at-least-32-characters-staging-access-secret
JWT_REFRESH_SECRET=replace-with-at-least-32-characters-staging-refresh-secret
COOKIE_SECRET=replace-with-at-least-32-characters-staging-cookie-secret
JWT_ACCESS_TOKEN_TTL=15m
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_REFRESH_TOKEN_TTL=7d
JWT_REFRESH_TOKEN_TTL_DAYS=7
JWT_ISSUER=color-trading-api
JWT_AUDIENCE=color-trading-client
GAME_MAX_BET_PER_USER_PER_ROUND=1000
GAME_MAX_EXPOSURE_PER_COLOR=100000
GAME_ENGINE_ENABLED=true
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_DISPLAY_NAME=Admin
ADMIN_BOOTSTRAP_CONFIRM=
ADMIN_BOOTSTRAP_ROTATE_PASSWORD=false
ADMIN_BOOTSTRAP_INITIAL_COINS=1000
ADMIN_BOOTSTRAP_TOKEN=replace-with-private-bootstrap-token
ADMIN_BOOTSTRAP_DISABLE_REASON=FIRST_ADMIN_CREATED
