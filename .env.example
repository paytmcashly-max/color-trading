NODE_ENV=development
SERVER_PORT=4000
CLIENT_PORT=3000
CLIENT_URL=http://localhost:3000
CLIENT_ORIGIN=http://localhost:3000
SOCKET_CORS_ORIGIN=http://localhost:3000
API_VERSION=v1
RELEASE_VERSION=0.1.0
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_API_BASE_PATH=/api/v1
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/color_trading
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-at-least-32-characters-shared-secret
JWT_ACCESS_SECRET=replace-with-at-least-32-characters-access-secret
JWT_REFRESH_SECRET=replace-with-at-least-32-characters-refresh-secret
JWT_ACCESS_TOKEN_TTL=15m
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_REFRESH_TOKEN_TTL=7d
JWT_REFRESH_TOKEN_TTL_DAYS=7
JWT_ISSUER=color-trading-api
JWT_AUDIENCE=color-trading-client
GAME_MAX_BET_PER_USER_PER_ROUND=1000
GAME_MAX_EXPOSURE_PER_COLOR=100000
GAME_ENGINE_ENABLED=true
