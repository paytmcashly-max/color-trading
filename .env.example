# Copy server values to apps/server/.env and client values to apps/client/.env.local.
# Never commit real production secrets.

# --- Server runtime ----------------------------------------------------------

# Required in every environment. Use production on Render.
NODE_ENV=development

# Optional; defaults to 4000. Render may inject this value.
PORT=4000

# Optional compatibility alias. CLIENT_ORIGIN is preferred.
# CLIENT_URL=http://localhost:3000

# Optional in dev; required operationally in production as the primary client origin.
CLIENT_ORIGIN=http://localhost:3000

# Optional in dev; explicitly required in production. Comma-separated URLs; never use *.
ALLOWED_ORIGINS=http://localhost:3000

# Optional compatibility alias. SOCKET_ALLOWED_ORIGINS is preferred.
# SOCKET_CORS_ORIGIN=http://localhost:3000

# Optional in dev; explicitly required in production. Comma-separated URLs; never use *.
SOCKET_ALLOWED_ORIGINS=http://localhost:3000

# Optional; fixed and validated as /api/v1. The server exposes application routes only here.
API_PREFIX=/api/v1

# Optional metadata used by health/version responses and structured logs.
API_VERSION=v1
RELEASE_VERSION=0.1.0

# Optional only for config-only development commands; required for a working server and production.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/color_trading

# Optional in local/test; required in staging and production.
REDIS_URL=redis://localhost:6379

# Required. Use different cryptographically random secrets of at least 32 characters.
JWT_ACCESS_SECRET=local-access-secret-change-before-shared-use-123
JWT_REFRESH_SECRET=local-refresh-secret-change-before-shared-use-456

# Legacy JWT fallback accepted by runtime but intentionally not configured. Do not use in production.
# JWT_SECRET=

# Optional in dev; required in production. Secret, random, stable, and at least 32 characters.
COOKIE_SECRET=local-cookie-secret-change-before-shared-use-789

# Optional in dev; required in production. Secret, unique, stable, and at least 32 characters.
ROUND_SEED_ENCRYPTION_KEY=local-round-seed-key-change-before-shared-use-abc

# Optional token settings; these pairs must describe the same durations.
JWT_ACCESS_TOKEN_TTL=15m
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_REFRESH_TOKEN_TTL=7d
JWT_REFRESH_TOKEN_TTL_DAYS=7
JWT_ISSUER=color-trading-api
JWT_AUDIENCE=color-trading-client

# Optional game engine settings. Betting duration must be less than round duration.
GAME_ROUND_DURATION_SECONDS=60
GAME_BETTING_DURATION_SECONDS=45
GAME_SCHEDULER_TICK_MS=1000
GAME_ROUND_LOCK_TTL_MS=5000
GAME_MAX_BET_PER_USER_PER_ROUND=1000
GAME_MAX_EXPOSURE_PER_COLOR=100000
GAME_ENGINE_ENABLED=true

# --- Main API to isolated payment-service link -------------------------------

# Disabled by default. When false, payment secrets are optional and checkout creation returns 503.
PAYMENT_SERVICE_ENABLED=false

# Required only when PAYMENT_SERVICE_ENABLED=true. PAYMENT_APP_URL is browser-facing.
PAYMENT_APP_URL=http://localhost:4100

# Secret, different values, at least 32 characters. Configure on main API and payment service.
PAYMENT_INTENT_SIGNING_SECRET=local-payment-intent-secret-change-before-shared-use
PAYMENT_SERVICE_SECRET=local-payment-service-secret-change-before-shared-use

# --- Compliance-gated real-money sandbox ------------------------------------

# All six flags must be true before any player/admin mutation route can operate.
# Keep false in production: this iteration fails fast if REAL_MONEY_ENABLED=true with NODE_ENV=production.
REAL_MONEY_ENABLED=false
COMPLIANCE_APPROVED=false
PAYMENT_PROVIDER_APPROVED=false
KYC_ENABLED=false
AML_CHECKS_ENABLED=false
RESPONSIBLE_GAMING_ENABLED=false
REAL_MONEY_TIMEZONE=Asia/Kolkata

# Integer paise only. Sandbox risk limits; review before any non-local enablement.
REAL_MONEY_WIN_PAYOUT_MULTIPLIER=2
MIN_REAL_MONEY_DEPOSIT_PAISE=1000
MAX_REAL_MONEY_DEPOSIT_PAISE=1000000
MIN_REAL_MONEY_WITHDRAWAL_PAISE=1000
MAX_REAL_MONEY_WITHDRAWAL_PAISE=1000000
MAX_REAL_MONEY_BET_PER_ROUND_PAISE=100000
MAX_REAL_MONEY_EXPOSURE_PER_ROUND_PAISE=1000000
MAX_REAL_MONEY_EXPOSURE_PER_COLOR_PAISE=500000
DAILY_REAL_MONEY_LOSS_LIMIT_PAISE=500000

# --- Isolated payment service runtime ----------------------------------------

PAYMENT_SERVICE_ENABLED=false
PAYMENT_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/color_trading_payments
MAIN_API_URL=http://localhost:4000
MAIN_CLIENT_URL=http://localhost:3000

# Secrets from Cashfree sandbox dashboard. Never expose to the client.
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_API_VERSION=2025-01-01
CASHFREE_BASE_URL=https://sandbox.cashfree.com/pg
CASHFREE_RETURN_URL=http://localhost:4100/return?order_id={order_id}
CASHFREE_WEBHOOK_URL=http://localhost:4100/api/webhooks/cashfree

# --- Client runtime ----------------------------------------------------------

# Browser-visible server origin. For the recommended production same-origin proxy, leave empty.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Browser-visible API path. Keep exactly /api/v1; do not append it to NEXT_PUBLIC_API_URL.
NEXT_PUBLIC_API_BASE_PATH=/api/v1

# Browser-visible Socket.IO server origin.
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# Server-only Next.js rewrite destination. Required when NEXT_PUBLIC_API_URL is empty.
BACKEND_API_URL=http://localhost:4000

# --- One-time admin bootstrap operations ------------------------------------

# Optional outside bootstrap. Remove all bootstrap-only values after first-admin setup.
ADMIN_BOOTSTRAP_EMAIL=admin@example.com

# Secret; 12-72 chars with uppercase, lowercase, number, and symbol. Never commit a real value.
ADMIN_BOOTSTRAP_PASSWORD=

# Set to PROMOTE_ADMIN only when intentionally promoting an existing normal user.
ADMIN_BOOTSTRAP_CONFIRM=

# Secret one-time authorization value; required by bootstrap scripts in production.
ADMIN_BOOTSTRAP_TOKEN=

# Optional bootstrap behavior.
ADMIN_DISPLAY_NAME=Admin
ADMIN_BOOTSTRAP_ROTATE_PASSWORD=false
ADMIN_BOOTSTRAP_INITIAL_COINS=1000
ADMIN_BOOTSTRAP_DISABLE_REASON=FIRST_ADMIN_CREATED
